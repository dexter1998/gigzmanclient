# ─────────────────────────────────────────────────────────────────────────
#  High Properties — server configuration
#  Copy this file to ".env" (same folder) and fill in the real values.
#  .env is blocked from the web by .htaccess. Never commit it anywhere public.
# ─────────────────────────────────────────────────────────────────────────

# ── MySQL (Hostinger: hPanel → Databases → MySQL Databases) ──────────────
# Leave these blank to run in JSON-file mode (works, but MySQL is recommended).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Staff sign-in ────────────────────────────────────────────────────────
# Seed the first admin here, then add the rest from the Manage Access panel.
# Generate a hash on the server:
#   php -r 'echo password_hash("your-strong-password", PASSWORD_DEFAULT);'
HP_USERS=[{"u":"yogesh","role":"admin","hash":"PASTE_BCRYPT_HASH_HERE"}]

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────
# developers.facebook.com → your app → WhatsApp → API Setup
# Leave blank and the site falls back to click-to-chat links (still works).
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v21.0
WA_APP_SECRET=
WA_OWNER_MSISDN=919821553693
WA_TEMPLATE_LEAD=
# Any random string; paste the same value into Meta's webhook setup screen.
WA_VERIFY_TOKEN=change-me-to-a-long-random-string
