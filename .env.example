# Postgres connection string. Local dev uses the Homebrew Postgres instance;
# production points at the hosted database.
DATABASE_URL=postgresql://user@localhost:5432/gigzman_client_sites

# Signing secret for dashboard session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# "path" -> tenant resolved from /{vertical}/{client}/... (shared deployment)
# "host"  -> tenant resolved from the request hostname (custom domain)
TENANT_MODE=path

# Gates the public template-library pages (/ and /{vertical}) and the
# internal /admin deployment index. Client tenant sites are never gated.
# Generate the hash with: node -e "console.log(require('bcryptjs').hashSync('<password>', 10))"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=

# Google Maps Embed API browser key. Optional: without it the map falls back to
# the free embed endpoint, which still shows a labelled pin but not Google's
# business card (rating, hours, directions).
#
# This key ships in the page HTML by design, so it MUST carry an HTTP-referrer
# restriction in the Google Cloud console — otherwise anyone can bill Maps
# requests to the project.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Maps JavaScript API browser key, for the Locator Plus map on tenants that opt
# in (lib/premium-v2/places.ts). NOT the same key as the one above unless that
# one is unrestricted: Locator Plus calls Maps JavaScript and Places, the embed
# above calls the Embed API. Left blank, those tenants fall back to the iframe
# map rather than breaking. Same referrer-restriction rule applies.
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# Vector Map ID from the Cloud console, used by the Locator Plus map. Falls
# back to Google's DEMO_MAP_ID, which works but is rate-limited and carries
# Google's own styling rather than the project's.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Gemini key for the site assistant (Ask AI / Summarize). Server-side
# only — it is read in app/api/ask/route.ts and must never be prefixed
# NEXT_PUBLIC_, which would compile it into the page. Without it the assistant
# returns 503 and its buttons stay hidden.
GEMINI_API_KEY=
